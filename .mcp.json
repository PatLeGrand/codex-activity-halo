{
  "mcpServers": {
    "activity_halo": {
      "command": "/usr/bin/python3",
      "args": [
        "./server.py"
      ],
      "cwd": ".",
      "startup_timeout_sec": 20,
      "env_vars": [
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "XDG_RUNTIME_DIR",
        "XDG_STATE_HOME",
        "DBUS_SESSION_BUS_ADDRESS",
        "XAUTHORITY",
        "ACTIVITY_HALO_MONITOR",
        "COMPUTER_USE_MCP_MONITOR",
        "HALO_AGENT"
      ]
    }
  }
}
